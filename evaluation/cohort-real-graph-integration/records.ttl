    ts:title "Associate Field Engineer" .

<https://example.org/trendscout/source-record/job-board/pinecone/4433b308-1ff4-4b5f-9184-810e5d9844f6/e79d58638e55dc4b> a ts:SourceRecord ;
    ts:about <https://example.org/trendscout/startup/pinecone> ;
