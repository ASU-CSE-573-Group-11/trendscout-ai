    ts:supports <https://example.org/trendscout/claim/7e6e6b9e4d2e6063998b> ;
    ts:title "Member of Technical Staff - Systems" .

<https://example.org/trendscout/source-record/job-board/modal/9fadb51f-ce11-41b1-84d5-470e66cc8ee9/fb044f60e8637168> a ts:SourceRecord ;
    ts:about <https://example.org/trendscout/startup/modal> ;
