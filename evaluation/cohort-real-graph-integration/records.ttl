    ts:documents <https://example.org/trendscout/job-posting/ashby/modal/5778babc-3f59-4b5f-9c60-10bc2b9a32e3> ;
    ts:eventAt "2026-11-20T09:03:12+00:00"^^xsd:dateTime ;
