<https://example.org/trendscout/source-record/32a5b90a-9b89-50c5-b05b-d060ac441c0b> a ts:SourceRecord ;
    ts:about <https://example.org/trendscout/startup/langchain> ;
    ts:collectorVersion "mixed-corpus/1.0" ;
