    ts:supports <https://example.org/trendscout/claim/b216f8fd0a4ca6cefb0a> ;
    ts:title "Infrastructure Security Engineer" .

<https://example.org/trendscout/source-record/job-board/modal/9b33ebe7-e829-4f03-97ba-5c94dbd7daf6/fb044f60e8637168> a ts:SourceRecord ;
    ts:about <https://example.org/trendscout/startup/modal> ;
