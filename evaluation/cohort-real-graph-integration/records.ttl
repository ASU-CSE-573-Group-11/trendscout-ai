    ts:title "Technical Recruiter" .

<https://example.org/trendscout/source-record/job-board/e2b/ad6febd3-7e17-403a-9449-fef78a8bb163/0d65148ea7948f32> a ts:SourceRecord ;
    ts:about <https://example.org/trendscout/startup/e2b> ;
