    ts:documents <https://example.org/trendscout/job-posting/ashby/pinecone/4ef4269b-94c4-4c7c-93ee-15a882caa767> ;
    ts:eventAt "2026-11-21T08:03:11+00:00"^^xsd:dateTime ;
