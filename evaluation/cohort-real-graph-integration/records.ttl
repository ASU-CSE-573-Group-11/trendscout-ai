    ts:title "Member of Technical Staff - Research, Post-Training" .

<https://example.org/trendscout/source-record/job-board/modal/84467a68-6876-4730-9d80-6c6f3d0c2d71/fb044f60e8637168> a ts:SourceRecord ;
