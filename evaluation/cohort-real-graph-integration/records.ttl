    ts:sourceUrl "https://jobs.ashbyhq.com/langchain/fc868832-3865-4f4a-8222-33422a7d3d96"^^xsd:anyURI ;
    ts:supports <https://example.org/trendscout/claim/83ed61415b51b25b3521> ;
    ts:title "Deployed Architect, Professional Services (Amsterdam)" .

