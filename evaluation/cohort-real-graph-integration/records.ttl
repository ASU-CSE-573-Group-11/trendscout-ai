    ts:title "Senior/Staff Software Engineer, Database Team" .

<https://example.org/trendscout/source-record/job-board/pinecone/7e7c824d-17a6-44ea-9485-6f04ceea5f29/e79d58638e55dc4b> a ts:SourceRecord ;
    ts:about <https://example.org/trendscout/startup/pinecone> ;
