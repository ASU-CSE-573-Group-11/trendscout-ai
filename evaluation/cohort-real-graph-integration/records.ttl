    ts:title "Brand Creative Director" .

<https://example.org/trendscout/source-record/job-board/e2b/2a86d352-77a2-4b32-9b36-7a0cef76262f/0d65148ea7948f32> a ts:SourceRecord ;
    ts:about <https://example.org/trendscout/startup/e2b> ;
