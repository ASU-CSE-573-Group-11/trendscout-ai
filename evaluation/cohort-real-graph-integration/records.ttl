<https://example.org/trendscout/source-record/364d3130-0325-5326-8978-ab6372a3a9e3> a ts:SourceRecord ;
    ts:about <https://example.org/trendscout/startup/langchain> ;
    ts:collectorVersion "mixed-corpus/1.0" ;
    ts:contentHash "3acbdbacb087a8bed8874c3ce64997637036551402acd36a01e1d3a90792e242" ;
    ts:documents <https://example.org/trendscout/job-posting/ashby/933a41a3-43ca-44de-a0ae-f541149151b7> ;
    ts:memberOfOrigin <https://example.org/trendscout/origin/d6371a9d69b9c64f> ;
    ts:mentions <https://example.org/trendscout/investor/benchmark>,
        <https://example.org/trendscout/investor/capitalg>,
