<https://example.org/trendscout/source-record/job-board/e2b/dea22a97-293e-41af-9fdb-c7e6e2c73b37/0d65148ea7948f32> a ts:SourceRecord ;
    ts:about <https://example.org/trendscout/startup/e2b> ;
