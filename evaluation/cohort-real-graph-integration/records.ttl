    ts:supports <https://example.org/trendscout/claim/d79ca196a682c508b652> ;
    ts:title "Developer Relations Engineer" .

<https://example.org/trendscout/source-record/job-board/modal/5778babc-3f59-4b5f-9c60-10bc2b9a32e3/fb044f60e8637168> a ts:SourceRecord ;
