    ts:supports <https://example.org/trendscout/claim/72092451692ef6fc0508> ;
    ts:title "Member of Technical Staff - Research, Inference" .

<https://example.org/trendscout/source-record/job-board/modal/7db771eb-e379-47fe-974f-765a8780dc10/fb044f60e8637168> a ts:SourceRecord ;
    ts:about <https://example.org/trendscout/startup/modal> ;
