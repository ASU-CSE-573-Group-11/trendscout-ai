    ts:title "Senior Frontend Platform Engineer, Design Systems" .

<https://example.org/trendscout/source-record/job-board/langchain/22bd243f-4088-49e0-bf02-fbad4442b0cb/c6e5e1dbaa58322a> a ts:SourceRecord ;
