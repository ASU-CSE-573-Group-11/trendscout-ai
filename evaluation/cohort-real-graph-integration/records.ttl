    ts:documents <https://example.org/trendscout/job-posting/ashby/0ee73994-b8a3-4a75-9675-da536abd3e10> ;
    ts:memberOfOrigin <https://example.org/trendscout/origin/0442c81bb66ffc45> ;
    ts:mentions <https://example.org/trendscout/investor/benchmark>,
        <https://example.org/trendscout/investor/capitalg>,
        <https://example.org/trendscout/investor/ivp>,
