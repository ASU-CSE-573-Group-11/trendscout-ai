{
  "snapshot_rule": "Every comparison uses one frozen dated snapshot. Do not mix live collection with scored evaluation.",
  "annotation_plan": {
    "documents": "40-50",
    "entity_mentions": "200+",
    "relations": "80-100",
    "annotators": "two team members, independently",
    "agreement": "report Cohen's kappa or equivalent after adjudication"
  },
  "retrieval_set": {
    "questions": "25-30",
    "temporal_multihop": "8-10",
    "insufficient_evidence": "6-8"
  },
  "trust_pilot": {
    "participants": "5-8",
    "tasks_each": "6-8",
    "conditions": ["citations_only", "citations_plus_state_and_path"],
    "measures": ["status_accuracy", "evidence_choice", "abstention_accuracy", "time", "confidence"]
  },
  "questions": [
    {
      "question_id": "q-pilot-github-mlops",
      "type": "temporal_multihop",
      "question": "Which agent-infrastructure startups show both rising GitHub activity and new MLOps hiring in the last eight weeks?",
      "expected_behavior": "answer_if_both_signals_else_qualify",
      "needs": ["github", "jobs"]
    },
    {
      "question_id": "q-investors-later-hiring",
      "type": "temporal_multihop",
      "question": "Which investors funded startups that later increased hiring for retrieval or evaluation skills?",
      "expected_behavior": "answer_with_valid_time_path",
      "needs": ["funding", "jobs"]
    },
    {
      "question_id": "q-sector-attention",
      "type": "temporal_multihop",
      "question": "Which sectors gained attention from multiple public voices and also produced operational signals?",
      "expected_behavior": "require_independent_origins_plus_jobs_or_github",
      "needs": ["public_voice", "github_or_jobs"]
    },
    {
      "question_id": "q-why-emerging",
      "type": "evidence_state",
      "question": "Why is a company marked as emerging, and what evidence could change that label?",
      "expected_behavior": "explain_ledger_state",
      "needs": ["evidence_ledger"]
    },
    {
      "question_id": "q-unsupported-acquisition",
      "type": "insufficient",
      "question": "Which frozen cohort company acquired Anthropic in 2024?",
      "expected_behavior": "abstain",
      "needs": []
    },
    {
      "question_id": "q-future-performance",
      "type": "insufficient",
      "question": "Which company in the cohort will have the highest valuation in 2027?",
      "expected_behavior": "abstain",
      "needs": []
    },
    {
      "question_id": "q-langchain-github-since-september",
      "type": "temporal_multihop",
      "question": "Did LangChain commit activity and hiring both rise since September?",
      "expected_behavior": "answer_if_both_signals_else_qualify",
      "needs": ["github", "jobs"]
    },
    {
      "question_id": "q-crewai-activity-eight-weeks",
      "type": "temporal",
      "question": "Did CrewAI repository activity rise during the last eight weeks?",
      "expected_behavior": "answer_with_valid_time",
      "needs": ["github"]
    },
    {
      "question_id": "q-startups-multi-signal-ten-weeks",
      "type": "temporal_multihop",
      "question": "Which startups combined hiring and repository growth over the last ten weeks?",
      "expected_behavior": "answer_if_both_signals_else_qualify",
      "needs": ["github", "jobs"]
    },
    {
      "question_id": "q-funding-after-hiring",
      "type": "temporal_multihop",
      "question": "Did companies that raised funding later increase hiring for retrieval or evaluation roles?",
      "expected_behavior": "answer_with_valid_time_path",
      "needs": ["funding", "jobs"]
    },
    {
      "question_id": "q-sector-multi-origin",
      "type": "temporal_multihop",
      "question": "Which cohort sectors received attention from at least two independent origins?",
      "expected_behavior": "require_independent_origins",
      "needs": ["public_voice", "news"]
    },
    {
      "question_id": "q-company-slowed-commits",
      "type": "temporal",
      "question": "Which companies showed declining repository activity during the last month?",
      "expected_behavior": "answer_with_valid_time",
      "needs": ["github"]
    },
    {
      "question_id": "q-llamaindex-retrieval-postings",
      "type": "temporal",
      "question": "Did LlamaIndex add retrieval roles in the latest observed quarter?",
      "expected_behavior": "answer_if_supported_else_qualify",
      "needs": ["jobs"]
    },
    {
      "question_id": "q-e2b-sandbox-coverage",
      "type": "temporal",
      "question": "How did news and public-voice coverage of E2B sandbox infrastructure change over the frozen window?",
      "expected_behavior": "answer_with_valid_time",
      "needs": ["news", "public_voice"]
    },
    {
      "question_id": "q-browserbase-agent-activity",
      "type": "temporal_multihop",
      "question": "Did Browserbase combine rising GitHub activity with public attention to browser automation?",
      "expected_behavior": "answer_if_both_signals_else_qualify",
      "needs": ["github", "public_voice"]
    },
    {
      "question_id": "q-composio-tool-postings",
      "type": "temporal",
      "question": "Did Composio increase postings for agent-tooling or developer-platform roles?",
      "expected_behavior": "answer_if_supported_else_qualify",
      "needs": ["jobs"]
    },
    {
      "question_id": "q-letta-memory-coverage",
      "type": "evidence_state",
      "question": "What evidence supports or weakens claims about Letta's agent-memory product?",
      "expected_behavior": "explain_ledger_state",
      "needs": ["evidence_ledger", "news", "github"]
    },
    {
      "question_id": "q-langfuse-observability-signals",
      "type": "temporal_multihop",
      "question": "Did Langfuse show growth in GitHub activity and LLM-observability hiring?",
      "expected_behavior": "answer_if_both_signals_else_qualify",
      "needs": ["github", "jobs"]
    },
    {
      "question_id": "q-haystack-rag-hiring",
      "type": "temporal",
      "question": "Did deepset add RAG or NLP engineering roles during the collection window?",
      "expected_behavior": "answer_if_supported_else_qualify",
      "needs": ["jobs"]
    },
    {
      "question_id": "q-funding-before-github-growth",
      "type": "temporal_multihop",
      "question": "For companies with funding announcements, did GitHub activity rise afterward?",
      "expected_behavior": "answer_with_valid_time_path",
      "needs": ["funding", "github"]
    },
    {
      "question_id": "q-missing-funding-langsmith",
      "type": "insufficient",
      "question": "Which investor led LangSmith's latest funding round?",
      "expected_behavior": "abstain_if_not_in_snapshot",
      "needs": ["funding"]
    },
    {
      "question_id": "q-outside-collection-window",
      "type": "insufficient",
      "question": "What was CrewAI's market share before the 2025-11-01 collection window?",
      "expected_behavior": "abstain",
      "needs": []
    },
    {
      "question_id": "q-future-acquisition",
      "type": "insufficient",
      "question": "Which cohort company will acquire a retrieval startup next year?",
      "expected_behavior": "abstain",
      "needs": []
    },
    {
      "question_id": "q-undocumented-private-metrics",
      "type": "insufficient",
      "question": "What private revenue growth did LangChain achieve in the latest quarter?",
      "expected_behavior": "abstain",
      "needs": []
    },
    {
      "question_id": "q-emerging-change-label",
      "type": "evidence_state",
      "question": "Why might a company claim remain emerging after one positive source?",
      "expected_behavior": "explain_ledger_state",
      "needs": ["evidence_ledger"]
    },
    {
      "question_id": "q-disputed-technical-claim",
      "type": "evidence_state",
      "question": "What evidence would change a technical company claim from corroborated to disputed?",
      "expected_behavior": "explain_ledger_state",
      "needs": ["evidence_ledger"]
    },
    {
      "question_id": "q-stale-source-label",
      "type": "evidence_state",
      "question": "Why should an old hiring claim be marked stale instead of corroborated?",
      "expected_behavior": "explain_ledger_state",
      "needs": ["evidence_ledger", "jobs"]
    },
    {
      "question_id": "q-independent-origin-definition",
      "type": "evidence_state",
      "question": "Would syndicated copies of the same funding article count as independent origins?",
      "expected_behavior": "explain_origin_rule",
      "needs": ["evidence_ledger"]
    }
  ],
  "metrics": {
    "extraction": ["precision", "recall", "f1", "alias_accuracy"],
    "retrieval": ["p@5", "r@5", "mrr", "ndcg@5"],
    "temporal": ["answer_accuracy", "valid_time_accuracy", "path_correctness", "stale_accuracy", "false_alert_rate"],
    "answer_quality": ["claim_support_rate", "citation_precision", "unsupported_claim_rate", "median_latency_seconds"],
    "success_thresholds": {
      "unsupported_claims_max": 0.10,
      "factual_claims_with_valid_evidence_min": 0.90,
      "trend_p_at_5_min": 0.70,
      "median_latency_seconds_max": 8
    }
  }
}
