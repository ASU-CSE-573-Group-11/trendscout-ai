    ts:title "Deployed Engineer, Professional Services (APAC)" .

<https://example.org/trendscout/source-record/364d3130-0325-5326-8978-ab6372a3a9e3> a ts:SourceRecord ;
    rdfs:subClassOf prov:Entity ;
    ts:about <https://example.org/trendscout/startup/langchain> ;
    ts:collectorVersion "mixed-corpus/1.0" ;
