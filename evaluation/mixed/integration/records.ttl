    ts:title "Deployed Engineer (Early Career- SF)" .

<https://example.org/trendscout/source-record/8a299686-3575-5e3b-9aeb-d69466277f57> a ts:SourceRecord ;
    rdfs:subClassOf prov:Entity ;
    ts:about <https://example.org/trendscout/startup/langchain> ;
    ts:collectorVersion "mixed-corpus/1.0" ;
    ts:contentHash "66e74350014da7a5cf613a7ffff5dc9e5000b4686ec3f41b53286f04e411de11" ;
