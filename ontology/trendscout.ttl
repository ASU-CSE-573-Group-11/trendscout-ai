@prefix ts: <https://example.org/trendscout/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ts:Startup a owl:Class .
ts:SourceRecord a owl:Class ;
    rdfs:subClassOf prov:Entity .
ts:Publisher a owl:Class ;
    rdfs:subClassOf prov:Agent .
ts:Claim a owl:Class ;
    rdfs:subClassOf prov:Entity .
ts:Event a owl:Class ;
    rdfs:subClassOf prov:Entity .
ts:Document a owl:Class ;
    rdfs:subClassOf prov:Entity .

ts:about a owl:ObjectProperty .
ts:publishedBy a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasAttributedTo .
ts:supports a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom .
ts:derivedFrom a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom .
ts:sameOriginAs a owl:ObjectProperty ;
    a owl:SymmetricProperty .

ts:eventAt a owl:DatatypeProperty ;
    rdfs:subPropertyOf schema:temporal .
ts:publishedAt a owl:DatatypeProperty ;
    rdfs:subPropertyOf schema:temporal .
ts:observedAt a owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:generatedAtTime .
ts:contentHash a owl:DatatypeProperty .
ts:sourceUrl a owl:DatatypeProperty .
ts:originClusterId a owl:DatatypeProperty .
ts:sourceType a owl:DatatypeProperty .
ts:passage a owl:DatatypeProperty .
ts:recordId a owl:DatatypeProperty .
ts:companyId a owl:DatatypeProperty .
ts:name a owl:DatatypeProperty .
