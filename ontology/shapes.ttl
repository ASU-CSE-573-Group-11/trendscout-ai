@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ts: <https://example.org/trendscout/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ts:SourceRecordShape
    a sh:NodeShape ;
    sh:targetClass ts:SourceRecord ;
    sh:property [
        sh:path ts:recordId ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path ts:sourceUrl ;
        sh:minCount 1 ;
        sh:datatype xsd:anyURI
    ] ;
    sh:property [
        sh:path ts:observedAt ;
        sh:minCount 1 ;
        sh:datatype xsd:dateTime
    ] ;
    sh:property [
        sh:path ts:contentHash ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path ts:originClusterId ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] .

ts:StartupShape
    a sh:NodeShape ;
    sh:targetClass ts:Startup ;
    sh:property [
        sh:path ts:companyId ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] .

ts:PublisherShape
    a sh:NodeShape ;
    sh:targetClass ts:Publisher ;
    sh:property [
        sh:path ts:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] .

ts:ClaimShape
    a sh:NodeShape ;
    sh:targetClass ts:Claim ;
    sh:property [
        sh:path ts:claimText ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path ts:state ;
        sh:minCount 1 ;
        sh:in ("emerging" "corroborated" "disputed" "stale" "insufficient")
    ] ;
    sh:property [
        sh:path ts:confidence ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1
    ] ;
    sh:property [
        sh:path ts:stateChangedAt ;
        sh:minCount 1 ;
        sh:datatype xsd:dateTime
    ] .

ts:InvestorShape
    a sh:NodeShape ;
    sh:targetClass ts:Investor ;
    sh:property [
        sh:path ts:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] .

ts:FundingRoundShape
    a sh:NodeShape ;
    sh:targetClass ts:FundingRound ;
    sh:property [
        sh:path ts:roundId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path ts:fundingOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ts:Startup
    ] ;
    sh:property [
        sh:path ts:observedAt ;
        sh:minCount 1 ;
        sh:datatype xsd:dateTime
    ] .

ts:JobPostingShape
    a sh:NodeShape ;
    sh:targetClass ts:JobPosting ;
    sh:property [
        sh:path ts:jobPostingId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path ts:title ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path ts:observedAt ;
        sh:minCount 1 ;
        sh:datatype xsd:dateTime
    ] .

ts:RepositoryShape
    a sh:NodeShape ;
    sh:targetClass ts:Repository ;
    sh:property [
        sh:path ts:repositoryId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path ts:sourceUrl ;
        sh:minCount 1 ;
        sh:datatype xsd:anyURI
    ] .

ts:SkillShape
    a sh:NodeShape ;
    sh:targetClass ts:Skill ;
    sh:property [
        sh:path ts:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] .

ts:TechnologyShape
    a sh:NodeShape ;
    sh:targetClass ts:Technology ;
    sh:property [
        sh:path ts:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] .
